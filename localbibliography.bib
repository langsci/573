@Article{gajewski_neg-raising_2007,
  author   = {Gajewski, Jon R.},
  journal  = {Linguistics and Philosophy},
  title    = {Neg-Raising and Polarity},
  year     = {2007},
  month    = jun,
  number   = {3},
  pages    = {289--328},
  volume   = {30},
  abstract = {The representation of Neg-Raising in the grammar is a matter of controversy. I provide evidence for representing Neg-Raising as a kind of presupposition associated with certain predicates by providing a detailed analysis of NPI-licensing in Neg-Raising contexts. Specific features of presupposition projection are used to explain the licensing of strict NPIs under Neg-Raising predicates. Discussion centers around the analysis of a licensing asymmetry noted in Horn (1971, Negative transportation: Unsafe at any speed? In CLS 7 (pp. 120–133)).Having provided this analysis, I go on to discuss its implications for the theory of NPI-licensing more generally. In particular, I discuss how the present proposal reflects on von Fintel’s (1999, Journal of Semantics, 16, 97–148) proposal to use Strawson downward entailment in the statement of NPI-licensing principles.},
  comment  = {02_docekal},
  doi      = {10.1007/s10988-007-9020-z},
  file     = {Full Text PDF:/home/mojmir/Zotero/storage/G2EJXT7R/Gajewski - 2007 - Neg-Raising and Polarity.pdf:application/pdf;Snapshot:/home/mojmir/Zotero/storage/I4PFN39A/10.html:text/html},
  owner    = {radeksimik},
}

